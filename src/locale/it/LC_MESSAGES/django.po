msgstr "Emby In visione ora disconnesso"

msgid "Enter the Emby server address, user name, and API key."
msgstr "Inserisci l'indirizzo del server Emby, il nome utente e la chiave API."

msgid "MediaTrail could not reach that Emby server."
msgstr "MediaTrail non è riuscito a raggiungere questo server Emby."

msgid "That Emby user name did not match exactly one account."
msgstr "Quel nome utente Emby non corrisponde a un solo account."

msgid "Emby Now Watching saved"
msgstr "Emby In visione ora salvato"

msgid "Device name"
msgstr "Nome dispositivo"

msgid "Limit user events to: Your Emby User"
msgstr "Limita eventi utente a: Il tuo utente Emby"

msgid "\"Limit library events to\" and \"Limit devices events to\" are optional"
msgstr "\"Limita eventi libreria a\" e \"Limita eventi dispositivi a\" sono facoltativi"

