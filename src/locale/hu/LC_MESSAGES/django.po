msgid "Choose the language of the interface. English is used when a translation is missing."
msgstr "A felület nyelve. Ha egy szövegnek nincs fordítása, angolul jelenik meg."

msgid "Hide Hover Overlay on Touch Devices"
msgstr "Lebegő réteg elrejtése érintőképernyőn"

msgid "Hide the media card hover overlay with action buttons on touch devices for a cleaner mobile experience. On desktop, the overlay will still appear when you hover your mouse over media cards."
msgstr "Érintőképernyőn elrejti a kártya lebegő gombjait. Asztali gépen az egér fölé húzásakor a réteg megmarad."

msgid "Obfuscate Unseen Episodes"
msgstr "Nem látott epizódok elhomályosítása"

msgid "When enabled, unseen episode images and descriptions will be blurred."
msgstr "A még nem látott epizódok képe és leírása elhomályosodik."

msgid "Bulk Completion Date"
msgstr "Tömeges befejezés dátuma"

msgid "When marking a TV show or season as completed, its episodes will be marked as completed with this date."
msgstr "Ha egy sorozatot vagy évadot befejezettnek jelölsz, az epizódok ezt a dátumot kapják."

msgid "Show progress bar on media items"
msgstr "Haladássáv a médián"

msgid "Display a progress bar on media items. Items which don't have max progress will be using a dotted line."
msgstr "Haladássáv a médiakártyákon. Ha nincs ismert maximum, a sáv pontozott."

msgid "Hide completed media in recommendations"
msgstr "Befejezett média elrejtése az ajánlásokból"

msgid "Hide media you've already completed from the recommendations section on detail pages."
msgstr "A részletes oldal ajánlásaiból kiveszi a már befejezett médiát."

msgid "Hide zero ratings"
msgstr "Nulla értékelés elrejtése"

msgid "Hide the rating badge from media cards when the rating is zero."
msgstr "Nulla értékelésnél nem jelenik meg az értékelés jelvénye."

msgid "Date Format"
msgstr "Dátumformátum"

msgid "Choose how dates are displayed throughout the application."
msgstr "A dátumok megjelenése az alkalmazásban."

msgid "Time Format"
msgstr "Időformátum"

msgid "Choose between 12-hour or 24-hour clock display."
msgstr "12 vagy 24 órás megjelenítés."

msgid "Week Start Day"
msgstr "A hét első napja"

msgid "Choose which day the week starts on for calendars and statistics."
msgstr "A naptár és a statisztika hetének első napja."

msgid "Watch provider region"
msgstr "Szolgáltató régiója"

msgid "Choose the region to show watch providers for. Setting this to disabled will hide the box from the media page."
msgstr "Melyik régió streaming szolgáltatói jelenjenek meg. Kikapcsolva a doboz eltűnik a médiaoldalról."

msgid "Media Types"
msgstr "Médiatípusok"

msgid "Media Type"
msgstr "Médiatípus"

msgid "Control which media types are visible throughout the app (sidebar, search, calendar, notifications)."
msgstr "Mely médiatípusok látszanak az oldalsávban, a keresőben, a naptárban és az értesítéseknél."

